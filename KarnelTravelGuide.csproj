<!-- KarnelTravelGuide.csproj - Project file for ASP.NET Core MVC application -->
<!-- Targeting .NET 8 with Entity Framework Core and SQL Server (LocalDB) -->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Target .NET 8 framework (LTS) for broad compatibility -->
	  <TargetFramework>net10.0</TargetFramework>
    <!-- Enable nullable reference types for safer code -->
    <Nullable>enable</Nullable>
    <!-- Treat warnings as errors for code quality -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Entity Framework Core - ORM for Code-First database approach -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.11" />
    <!-- EF Core SQL Server provider for LocalDB connection -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.11" />
    <!-- EF Core design-time tools for migrations -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- ASP.NET Core MVC Newtonsoft JSON support -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="8.0.11" />
  </ItemGroup>

</Project>
