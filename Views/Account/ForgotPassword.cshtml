@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Reset - KarnelTravelGuide</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Merriweather:wght@700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background: #f8fdfb; margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
        body::before { content: ''; position: absolute; top: -80px; left: -80px; width: 350px; height: 350px; background: #e6f4f0; border-radius: 50%; }
        body::after { content: ''; position: absolute; bottom: -100px; right: -80px; width: 380px; height: 380px; background: #fdf3d7; border-radius: 50%; }
        .login-card { position: relative; z-index: 2; width: 900px; max-width: 95%; background: white; border-radius: 20px; box-shadow: 0 20px 60px rgba(0,0,0,0.08); display: flex; overflow: hidden; }
        .left { background: linear-gradient(160deg, #1a6b5a 0%, #0f4a3e 100%); width: 42%; padding: 45px 35px; color: white; }
        .icon-box { background: #EAB84C; width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; color: #0f4a3e; font-size: 18px; }
        .logo-text { font-family: 'Merriweather', serif; font-weight: 800; margin-top: 15px; font-size: 18px; }
        .logo-text span { color: #EAB84C; }
        .left h2 { font-family: 'Merriweather', serif; font-weight: 800; font-size: 32px; margin-top: 35px; line-height: 1.2; }
        .left p.desc { font-size: 13px; opacity: 0.8; line-height: 1.6; margin-top: 12px; }
        .feature { margin-top: 22px; display: flex; gap: 12px; align-items: flex-start; }
        .feature-icon { background: #EAB84C; width: 26px; height: 26px; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: #0f4a3e; font-size: 12px; }
        .feature b { font-size: 12px; display: block; } .feature span { font-size: 11px; opacity: 0.7; }
        .right { width: 58%; padding: 50px 50px; }
        .right h3 { font-family: 'Merriweather', serif; font-weight: 800; color: #134e42; font-size: 26px; }
        .right .sub { font-size: 12px; color: #888; margin-bottom: 28px; margin-top: 5px; }
        .form-label { font-size: 10px; font-weight: 700; letter-spacing: 0.8px; color: #b89b5a; margin-bottom: 6px; text-transform: uppercase; }
        .input-wrap { position: relative; } .input-wrap i.input-icon { position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: #b89b5a; font-size: 13px; }
        .form-control { background: #f7f7f7; border: 1px solid #eee; border-radius: 25px; padding: 12px 18px 12px 42px; font-size: 13px; }
        .form-control:focus { background: white; border-color: #EAB84C; box-shadow: none; }
        .btn-gold { background: #EAB84C; border: none; border-radius: 25px; padding: 12px; width: 100%; color: #222; font-weight: 700; font-size: 14px; box-shadow: 0 8px 20px rgba(234,184,76,0.35); margin-top: 15px; }
        .btn-gold:hover { background: #d9a53e; }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="left">
            <div class="icon-box"><i class="fa-solid fa-plane"></i></div>
            <div class="logo-text">Karnel<span>TravelGuide</span></div>
            <h2>Reset your password.</h2>
            <p class="desc">Don't worry, it happens. Enter your email to reset.</p>
            <div class="feature"><div class="feature-icon"><i class="fa-solid fa-check"></i></div><div><b>Quick Reset</b><span>Change in seconds.</span></div></div>
            <div class="feature"><div class="feature-icon"><i class="fa-solid fa-check"></i></div><div><b>Secure</b><span>Your data is safe.</span></div></div>
        </div>
        <div class="right">
            <h3>Reset Password</h3>
            <p class="sub">Enter your email and new password.</p>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger py-2" style="font-size:13px; border-radius:12px;">@ViewBag.Error</div>
            }

            <form method="post">
                <label class="form-label">Your Email</label>
                <div class="input-wrap mb-3">
                    <i class="fa-regular fa-envelope input-icon"></i>
                    <input name="Email" type="email" class="form-control" placeholder="you@example.com" required />
                </div>
                <label class="form-label">New Password</label>
                <div class="input-wrap mb-2">
                    <i class="fa-solid fa-lock input-icon"></i>
                    <input name="NewPassword" type="password" class="form-control" placeholder="••••••••" required />
                </div>
                <button type="submit" class="btn-gold">Reset Password <i class="fa-solid fa-arrow-right ms-1"></i></button>
            </form>
            <div class="text-center mt-4" style="font-size:12px;">
                <a href="/Account/Login" style="color:#134e42; font-weight:700; text-decoration:none;">Back to Login</a>
            </div>
            <div class="text-center mt-4" style="font-size:10px; color:#aaa;">© 2026 Karnel TravelGuide</div>
        </div>
    </div>
</body>
</html>