@{
    ViewData["Title"] = "Login";
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Login - KarnelTravelGuide</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Merriweather:wght@700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: #f8fdfb;
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
        }
        body::before {
            content: '';
            position: absolute;
            top: -80px;
            left: -80px;
            width: 350px;
            height: 350px;
            background: #e6f4f0;
            border-radius: 50%;
        }
        body::after {
            content: '';
            position: absolute;
            bottom: -100px;
            right: -80px;
            width: 380px;
            height: 380px;
            background: #fdf3d7;
            border-radius: 50%;
        }
        .login-card {
            position: relative;
            z-index: 2;
            width: 900px;
            max-width: 95%;
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.08);
            display: flex;
            overflow: hidden;
        }
        .left {
            background: linear-gradient(160deg, #1a6b5a 0%, #0f4a3e 100%);
            width: 42%;
            padding: 45px 35px;
            color: white;
            position: relative;
        }
        .icon-box {
            background: #EAB84C;
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #0f4a3e;
            font-size: 18px;
        }
        .logo-text {
            font-family: 'Merriweather', serif;
            font-weight: 800;
            margin-top: 15px;
            font-size: 18px;
        }
        .logo-text span { color: #EAB84C; }
        .left h2 {
            font-family: 'Merriweather', serif;
            font-weight: 800;
            font-size: 32px;
            margin-top: 35px;
            line-height: 1.2;
        }
        .left p.desc {
            font-size: 13px;
            opacity: 0.8;
            line-height: 1.6;
            margin-top: 12px;
        }
        .feature {
            margin-top: 22px;
            display: flex;
            gap: 12px;
            align-items: flex-start;
        }
        .feature-icon {
            background: #EAB84C;
            width: 26px;
            height: 26px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #0f4a3e;
            font-size: 12px;
            flex-shrink: 0;
        }
        .feature b { font-size: 12px; display: block; }
        .feature span { font-size: 11px; opacity: 0.7; }
        .right {
            width: 58%;
            padding: 50px 50px;
        }
        .right h3 {
            font-family: 'Merriweather', serif;
            font-weight: 800;
            color: #134e42;
            font-size: 26px;
        }
        .right .sub {
            font-size: 12px;
            color: #888;
            margin-bottom: 28px;
            margin-top: 5px;
        }
        .form-label {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.8px;
            color: #b89b5a;
            margin-bottom: 6px;
            text-transform: uppercase;
        }
        .input-wrap { position: relative; }
        .input-wrap i.input-icon {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: #b89b5a;
            font-size: 13px;
        }
        .form-control {
            background: #f7f7f7;
            border: 1px solid #eee;
            border-radius: 25px;
            padding: 12px 18px 12px 42px;
            font-size: 13px;
        }
        .form-control:focus {
            background: white;
            border-color: #EAB84C;
            box-shadow: none;
        }
        .btn-gold {
            background: #EAB84C;
            border: none;
            border-radius: 25px;
            padding: 12px;
            width: 100%;
            color: #222;
            font-weight: 700;
            font-size: 14px;
            box-shadow: 0 8px 20px rgba(234,184,76,0.35);
            margin-top: 10px;
        }
        .btn-gold:hover { background: #d9a53e; }
        .link-small {
            font-size: 11px;
            color: #1a6b5a;
            text-decoration: none;
            font-weight: 600;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="left">
            <div class="icon-box"><i class="fa-solid fa-plane"></i></div>
            <div class="logo-text">Karnel<span>TravelGuide</span></div>
            <h2>Welcome back.</h2>
            <p class="desc">Sign in to your account and continue exploring beautiful Karachi resorts.</p>
            <div class="feature">
                <div class="feature-icon"><i class="fa-solid fa-check"></i></div>
                <div><b>Secure Access</b><span>Your account is protected.</span></div>
            </div>
            <div class="feature">
                <div class="feature-icon"><i class="fa-solid fa-check"></i></div>
                <div><b>Easy Booking</b><span>Book your favorite resorts.</span></div>
            </div>
            <div class="feature">
                <div class="feature-icon"><i class="fa-solid fa-check"></i></div>
                <div><b>Powerful Dashboard</b><span>Manage your trips with ease.</span></div>
            </div>
        </div>
        <div class="right">
            <h3>Sign in</h3>
            <p class="sub">Enter your credentials to continue.</p>
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger py-2" style="font-size:13px; border-radius:12px;">@ViewBag.Error</div>
            }
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success py-2" style="font-size:13px; border-radius:12px;">@TempData["Success"]</div>
            }
            <form asp-action="Login" method="post">
                <div class="d-flex justify-content-between">
                    <label class="form-label">Email Address</label>
                </div>
                <div class="input-wrap mb-3">
                    <i class="fa-regular fa-envelope input-icon"></i>
                    <input name="Email" class="form-control" placeholder="you@example.com" required />
                </div>
                <div class="d-flex justify-content-between">
                    <label class="form-label">Password</label>
                    <a href="/Account/ForgotPassword" class="link-small">Forgot password?</a>
                </div>
                <div class="input-wrap mb-2">
                    <i class="fa-solid fa-lock input-icon"></i>
                    <input name="Password" type="password" class="form-control" placeholder="••••••••" required />
                    <i class="fa-regular fa-eye" style="position:absolute; right:16px; top:50%; transform:translateY(-50%); color:#aaa; font-size:13px; cursor:pointer;"></i>
                </div>
                <div class="mb-4 mt-3 d-flex align-items-center gap-2">
                    <input type="checkbox" style="accent-color:#134e42;" checked />
                    <span style="font-size:12px; color:#555;">Remember me</span>
                </div>
                <button type="submit" class="btn-gold">Sign In <i class="fa-solid fa-arrow-right ms-1"></i></button>
                <div class="text-center mt-3" style="font-size:11px; color:#aaa;">
                    <i class="fa-solid fa-lock" style="color:#EAB84C;"></i> Secure user access
                </div>
            </form>
            <div class="text-center mt-4" style="font-size:12px;">
                Don't have account? <a asp-action="Register" style="color:#134e42; font-weight:700; text-decoration:none;">Sign Up</a>
            </div>
            <hr class="mt-4" style="opacity:0.08" />
            <div class="text-center" style="font-size:10px; color:#aaa;">© 2026 Karnel TravelGuide</div>
        </div>
    </div>
</body>
</html>