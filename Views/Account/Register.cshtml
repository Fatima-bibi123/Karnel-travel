@model KarnelTravelGuide.Models.User
@{
    ViewData["Title"] = "Register";
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Register - KarnelTravelGuide</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Merriweather:wght@700;800&family=Poppins:wght@400;600&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Poppins', sans-serif; background: #f8f9fa; }
        .main { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px; }
        .box { max-width: 1000px; width: 100%; background: white; border-radius: 20px; overflow: hidden; display: flex; box-shadow: 0 20px 60px rgba(0,0,0,0.15); }
        .left-side {
            width: 48%;
            background: linear-gradient(rgba(74, 122, 122, 0.85), rgba(74, 122, 122, 0.85)), url('https://images.unsplash.com/photo-1507525428034-b723cf961d3e');
            background-size: cover; background-position: center;
            padding: 40px; color: white; display: flex; flex-direction: column;
        }
        .logo { font-family: 'Merriweather', serif; font-weight: 800; font-size: 24px; }
        .logo i { color: #EAA324; }
        .left-content { margin-top: auto; margin-bottom: auto; }
        .left-content h2 { font-family: 'Merriweather', serif; font-size: 42px; font-weight: 800; line-height: 1.1; }
        .badge-beach { background: #EAA324; color: white; padding: 6px 16px; border-radius: 20px; font-size: 12px; letter-spacing: 1px; font-weight: 600; display: inline-block; margin-bottom: 15px; }
        .right-side { width: 52%; padding: 50px 45px; }
        .form-control { background: #f6f6f6; border: 1px solid #eeeeee; border-radius: 12px; padding: 13px 18px; }
        .form-control:focus { border-color: #EAA324; box-shadow: none; background: #fff; }
        label { font-weight: 600; font-size: 13px; margin-bottom: 6px; color: #333; }
        .btn-gold { background: #EAA324; border: none; border-radius: 30px; padding: 12px; width: 100%; color: white; font-weight: 700; }
        .btn-gold:hover { background: #d8901f; color: white; }
        .link-gold { color: #EAA324; font-weight: 700; text-decoration: none; }
    </style>
</head>
<body>
    <div class="main">
        <div class="box">
            <!-- Left - Same as your Home -->
            <div class="left-side">
                <div class="logo"><i class="fa-solid fa-plane-departure"></i> KarnelTravelGuide</div>
                <div class="left-content">
                    <span class="badge-beach">BEACH</span>
                    <h2>Sea View<br>Beach</h2>
                    <p style="margin-top:15px; opacity:0.9; line-height:1.6; font-size:14px;">
                        <i class="fa-solid fa-location-dot" style="color:#EAA324"></i> <span style="color:#EAA324; font-weight:600;">Karachi</span><br>
                        Join us to explore the most beautiful resorts in Karachi and make your travel dreams come true.
                    </p>
                </div>
            </div>
            <!-- Right - Form -->
            <div class="right-side">
                <h3 style="font-family:'Merriweather'; font-weight:800;">User Register</h3>
                <p class="text-muted small mb-4">Create your account</p>

                @if (ViewBag.Error != null)
                { <div class="alert alert-danger" style="border-radius:12px; font-size:14px;">@ViewBag.Error</div> }

                <form asp-action="Register" method="post">
                    <div class="mb-3">
                        <label>Full Name</label>
                        <input asp-for="Name" class="form-control" placeholder="Full Name" required />
                    </div>
                    <div class="mb-3">
                        <label>Email</label>
                        <input asp-for="Email" class="form-control" placeholder="Email" required />
                    </div>
                    <div class="mb-3">
                        <label>Phone</label>
                        <input asp-for="Phone" class="form-control" placeholder="Phone" />
                    </div>
                    <div class="mb-3">
                        <label>Password</label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Password" required />
                    </div>
                    <button type="submit" class="btn-gold mt-2">Register <i class="fa-solid fa-arrow-right ms-2"></i></button>
                </form>
                <div class="text-center mt-4 small">
                    Already have account? <a asp-action="Login" class="link-gold">Login</a>
                </div>
            </div>
        </div>
    </div>
</body>
</html>