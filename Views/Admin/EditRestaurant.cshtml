@model KarnelTravelGuide.Models.Restaurant
@{
    ViewData["Title"] = "Update Restaurant";
}

<div class="page-head">
    <div>
        <h1>Update Restaurant</h1>
        <p>Edit restaurant and dining details.</p>
    </div>
    <a href="/Admin/Restaurants" class="btn btn-light">← Back</a>
</div>

<div class="card">
    <form asp-controller="Admin"
          asp-action="EditRestaurant"
          asp-route-id="@Model.Id"
          method="post"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ImageUrl" />

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        @if (ViewBag.FormErrors != null)
        {
            <div class="alert alert-danger">
                <ul>
                    @foreach (var error in ViewBag.FormErrors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }

        <div class="form-grid">
            <div class="form-group">
                <label asp-for="Name">Restaurant Name</label>
                <input asp-for="Name" class="form-control" placeholder="Enter restaurant name" required />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="City">Location / City</label>
                <input asp-for="City" class="form-control" placeholder="Enter location" required />
                <span asp-validation-for="City" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Cuisine">Cuisine</label>
                <input asp-for="Cuisine" class="form-control" placeholder="Enter cuisine" />
                <span asp-validation-for="Cuisine" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Price">Price (PKR)</label>
                <input asp-for="Price" type="number" step="0.01" min="0" class="form-control" placeholder="Enter price" required />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Rating">Rating (1-5)</label>
                <input asp-for="Rating" type="number" min="0" max="5" step="0.1" class="form-control" placeholder="Enter rating" />
                <span asp-validation-for="Rating" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Replace Restaurant Image (optional)</label>
                <input type="file" name="ImageFile" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <p style="margin-top:8px;">Current image:</p>
                    <img src="@Model.ImageUrl" alt="Current restaurant image" style="max-width:180px;max-height:130px;object-fit:cover;border-radius:8px;" />
                }
                else
                {
                    <p style="margin-top:8px;">No image uploaded.</p>
                }
            </div>

            <div class="form-group">
                <label asp-for="Availability">Available?</label>
                <div><input asp-for="Availability" type="checkbox" /></div>
            </div>
        </div>

        <br />
        <div class="actions">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a href="/Admin/Restaurants" class="btn btn-light">Cancel</a>
        </div>
    </form>
</div>