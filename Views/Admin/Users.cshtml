@model List<KarnelTravelGuide.Models.User>
@{
    ViewData["Title"] = "Users";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@if (TempData["SuccessMessage"] != null){<div style="background:#e8f5e9;color:#2e7d32;padding:12px;border-radius:8px;margin-bottom:15px;">@TempData["SuccessMessage"]</div>}

<div class="page-head">
    <div><h1>Users</h1><p>Manage registered users and account information.</p></div>
    <a href="/Admin/AddUser" class="btn btn-primary">＋ Add User</a>
</div>

<div class="card">
    <form method="get" class="filters" style="display:flex;gap:10px;margin-bottom:15px;">
        <input name="search" placeholder="Search users..." value="@Context.Request.Query["search"]" style="padding:8px;border-radius:6px;border:1px solid #ddd;">
        <select name="status" style="padding:8px;border-radius:6px;border:1px solid #ddd;">
            <option>All Status</option><option>Active</option><option>Blocked</option>
        </select>
        <button type="submit" class="btn btn-light">Filter</button>
    </form>
    <div class="table-wrap">
        <table>
            <thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Role</th><th>Status</th><th>Joined</th><th>Action</th></tr></thead>
            <tbody>
            @foreach(var u in Model){
                <tr>
                    <td>@u.Name</td><td>@u.Email</td><td>@u.Phone</td><td>@u.Role</td>
                    <td><a href="/Admin/ToggleUserStatus/@u.Id"><span class="badge @(u.Status=="Active"?"confirmed":"cancelled")">@u.Status</span></a></td>
                    <td>@u.JoinedDate.ToString("MMM dd, yyyy")</td>
                    <td><a href="/Admin/DeleteUser/@u.Id" onclick="return confirm('Delete?')" style="color:red;">Delete</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>