@model KarnelTravelGuide.Models.Hotel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="card" style="padding:25px">
<h2>Add New Hotel</h2>
<form asp-action="AddHotel" enctype="multipart/form-data" method="post">
    <label>Name</label><input name="Name" class="form-control" required />
    <label>City</label><input name="City" class="form-control" required />
    <label>Price Per Night (PKR)</label><input name="PricePerNight" type="number" class="form-control" required />
    <label>Rating (1-5)</label><input name="Rating" type="number" min="1" max="5" class="form-control" />
    <label>Image</label><input type="file" name="ImageFile" class="form-control" />
    <label>Available?</label><input type="checkbox" name="Availability" value="true" checked /> Yes
    <br/><br/>
    <button class="btn btn-primary">Save Hotel</button>
</form>
</div>