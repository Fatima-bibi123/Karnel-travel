
@model IEnumerable<KarnelTravelGuide.Models.TouristSpot>

@{
    ViewData["Title"] = "Tourist Spots";
    var spots = Model ?? Enumerable.Empty<KarnelTravelGuide.Models.TouristSpot>();
}

<div class="page-head">
    <div>
        <h1>Tourist Spots</h1>
        <p>Manage destinations and tourist attractions.</p>
    </div>

    <a href="/Admin/AddTouristSpot" class="btn btn-primary">
        ＋ Add Tourist Spot
    </a>
</div>

<div class="card">
    <div class="filters">
        <input type="text"
               placeholder="Search tourist spots..."
               id="pageSearch"
               oninput="filterSpots()">

        <select id="statusFilter" onchange="filterSpots()">
            <option value="all">All Status</option>
            <option value="active">Active</option>
            <option value="unavailable">Unavailable</option>
        </select>

        <button type="button"
                class="btn btn-light"
                onclick="filterSpots()">
            Filter
        </button>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" style="margin:12px;">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" style="margin:12px;">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="table-wrap">
        <table id="spotsTable">
            <thead>
                <tr>
                    <th>Spot</th>
                    <th>Region</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var spot in spots)
                {
                    <tr>
                        <td>@spot.Name</td>
                        <td>@spot.Location</td>
                        <td>@spot.Category</td>
                        <td>Rs. @spot.Price</td>

                        <td>
                            @if (spot.Availability)
                            {
                                <span class="badge confirmed">Active</span>
                            }
                            else
                            {
                                <span class="badge">Unavailable</span>
                            }
                        </td>

                        <td>
                            <div class="actions"
                                 style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">

                                <a href="@Url.Action("EditTouristSpot", "Admin", new { id = spot.Id })"
                                   class="btn btn-light"
                                   title="Update Tourist Spot"
                                   style="display:inline-flex;align-items:center;justify-content:center;padding:8px 12px;background:#e8f3ff;color:#1765a8;border:1px solid #c8e0fa;border-radius:8px;text-decoration:none;font-size:12px;font-weight:600;white-space:nowrap;">
                                    ✎ Update
                                </a>

                                <form action="@Url.Action("DeleteTouristSpot", "Admin")"
                                      method="post"
                                      style="display:inline;margin:0;"
                                      onsubmit="return confirm('Kya aap is tourist spot ko delete karna chahti hain?');">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@spot.Id" />

                                    <button type="submit"
                                            class="btn btn-light"
                                            title="Delete Tourist Spot"
                                            style="display:inline-flex;align-items:center;justify-content:center;padding:8px 12px;background:#fff0ef;color:#c62828;border:1px solid #f5c2bf;border-radius:8px;font-size:12px;font-weight:600;cursor:pointer;white-space:nowrap;">
                                        🗑 Delete
                                    </button>
                                </form>

                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (!spots.Any())
        {
            <p style="padding:20px;text-align:center;">
                No tourist spots found. Add one!
            </p>
        }
    </div>
</div>

<script>
    function filterSpots() {
        const searchInput = document.getElementById("pageSearch");
        const statusFilter = document.getElementById("statusFilter");

        const searchValue = searchInput.value.toLowerCase().trim();
        const statusValue = statusFilter.value;

        const rows = document.querySelectorAll(
            "#spotsTable tbody tr"
        );

        rows.forEach(function (row) {
            const rowText = row.innerText.toLowerCase();
            const statusText = row.cells[4].innerText
                .toLowerCase()
                .trim();

            const matchesSearch = rowText.includes(searchValue);

            const matchesStatus =
                statusValue === "all" ||
                (statusValue === "active" &&
                    statusText.includes("active") &&
                    !statusText.includes("unavailable")) ||
                (statusValue === "unavailable" &&
                    statusText.includes("unavailable"));

            row.style.display =
                matchesSearch && matchesStatus ? "" : "none";
        });
    }
</script>
