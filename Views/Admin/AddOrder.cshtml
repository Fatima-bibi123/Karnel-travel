@model KarnelTravelGuide.Models.Order
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Add Order";
}
<div class="page-head">
    <div>
        <h1 style="color:#165e5a; font-size:26px; font-weight:800; margin:0;">Add New Order</h1>
        <p style="color:#888; font-size:14px;">Create a manual booking.</p>
    </div>
    <a href="/Admin/Orders" style="border-radius:20px; border:1px solid #ddd; padding:8px 16px; text-decoration:none;">← Back</a>
</div>

<div class="card" style="padding:25px; border-radius:16px; margin-top:20px;">
    <form asp-action="AddOrder" method="post">
        @Html.AntiForgeryToken()
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:15px;">
            <div><label>Full Name</label><input asp-for="FullName" class="form-control" required style="padding:10px; border-radius:10px; border:1px solid #ddd; width:100%;" /></div>
            <div><label>Email</label><input asp-for="Email" class="form-control" required style="padding:10px; border-radius:10px; border:1px solid #ddd; width:100%;" /></div>
            <div><label>Phone</label><input asp-for="Phone" class="form-control" required style="padding:10px; border-radius:10px; border:1px solid #ddd; width:100%;" /></div>
            <div><label>Order Type</label>
                <select asp-for="OrderType" class="form-control" required style="padding:10px; border-radius:10px; border:1px solid #ddd; width:100%;">
                    <option value="Hotel">Hotel</option>
                    <option value="Restaurant">Restaurant</option>
                    <option value="Resort">Resort</option>
                    <option value="Tourist Spot">Tourist Spot</option>
                </select>
            </div>
            <div><label>Location</label><input asp-for="Location" class="form-control" required style="padding:10px; border-radius:10px; border:1px solid #ddd; width:100%;" /></div>
            <div><label>Check In Date</label><input asp-for="CheckInDate" type="date" class="form-control" required style="padding:10px; border-radius:10px; border:1px solid #ddd; width:100%;" /></div>
            <div><label>Quantity</label><input asp-for="Quantity" type="number" class="form-control" required style="padding:10px; border-radius:10px; border:1px solid #ddd; width:100%;" /></div>
            <div style="grid-column: span 2;"><label>Details</label><textarea asp-for="Details" class="form-control" style="padding:10px; border-radius:10px; border:1px solid #ddd; width:100%;"></textarea></div>
        </div>
        <br/>
        <button type="submit" style="background:#f5c86e; color:#5a3d00; border-radius:20px; padding:10px 20px; font-weight:700; border:none; cursor:pointer;">Save Order</button>
    </form>
</div>