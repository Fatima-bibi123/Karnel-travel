@model KarnelTravelGuide.Models.Restaurant
@{
    ViewData["Title"] = "Add Restaurant";
}

<div class="page-head">
    <div>
        <h1>Add Restaurant</h1>
        <p>Create a new restaurant listing.</p>
    </div>
    <a href="/Admin/Restaurants" class="btn btn-light">← Back</a>
</div>

<div class="card">
    <form asp-controller="Admin"
          asp-action="AddRestaurant"
          method="post"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        @if (ViewBag.FormErrors != null)
        {
            <div class="alert alert-danger">
                <ul>
                    @foreach (var error in ViewBag.FormErrors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }

        <div class="form-grid">
            <div class="form-group">
                <label asp-for="Name">Restaurant Name</label>
                <input asp-for="Name" class="form-control" placeholder="Enter restaurant name" required />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="City">Location / City</label>
                <input asp-for="City" class="form-control" placeholder="Enter location" required />
                <span asp-validation-for="City" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Cuisine">Cuisine</label>
                <input asp-for="Cuisine" class="form-control" placeholder="Enter cuisine" required />
                <span asp-validation-for="Cuisine" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Price">Price (PKR)</label>
                <input asp-for="Price" type="number" step="0.01" min="0" class="form-control" placeholder="Enter price" required />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Rating">Rating (1-5)</label>
                <input asp-for="Rating" type="number" min="1" max="5" step="0.1" class="form-control" placeholder="Enter rating" />
                <span asp-validation-for="Rating" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Upload Restaurant Image</label>
                <input type="file" name="ImageFile" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
            </div>

            <div class="form-group">
                <label asp-for="Availability">Available?</label>
                <div><input asp-for="Availability" type="checkbox" checked /></div>
            </div>
        </div>

        <br />
        <div class="actions">
            <button type="submit" class="btn btn-primary">Save Restaurant</button>
            <a href="/Admin/Restaurants" class="btn btn-light">Cancel</a>
        </div>
    </form>
</div>