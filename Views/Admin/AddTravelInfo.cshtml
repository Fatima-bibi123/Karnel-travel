@model KarnelTravelGuide.Models.TravelInfo
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Add Travel Info";
}
<div class="page-head">
    <div><h1>Add Travel Info</h1><p>Add new transportation route.</p></div>
    <a href="/Admin/TravelInfo" class="btn btn-light">← Back</a>
</div>
<div class="card" style="padding:20px">
    @if (ViewBag.FormErrors != null)
    {
        <div style="background:#fff0ef; padding:10px; border-radius:8px; margin-bottom:15px;">
            @foreach(var err in ViewBag.FormErrors) { <div style="color:#c62828; font-size:13px;">@err</div> }
        </div>
    }
    <form asp-action="AddTravelInfo" method="post">
        @Html.AntiForgeryToken()
        <div class="form-grid" style="display:grid; grid-template-columns:1fr 1fr; gap:15px;">
            <div class="form-group">
                <label>From City</label>
                <select asp-for="FromCity" class="form-control" required>
                    <option value="">-- Select --</option>
                    <option>Karachi</option><option>Lahore</option><option>Islamabad</option><option>Hunza Valley</option><option>Murree</option><option>Skardu</option>
                </select>
            </div>
            <div class="form-group">
                <label>To City</label>
                <select asp-for="ToCity" class="form-control" required>
                    <option value="">-- Select --</option>
                    <option>Karachi</option><option>Lahore</option><option>Islamabad</option><option>Hunza Valley</option><option>Murree</option><option>Skardu</option>
                </select>
            </div>
            <div class="form-group">
                <label>Transport Type</label>
                <select asp-for="TransportType" class="form-control" required>
                    <option value="">-- Select --</option>
                    <option>Bus</option><option>Train</option><option>Flight</option><option>Car</option><option>Jeep</option>
                </select>
            </div>
            <div class="form-group">
                <label>Price (PKR)</label>
                <input asp-for="Price" type="number" step="0.01" min="0" class="form-control" placeholder="e.g. 5000" required />
            </div>
        </div>
        <br/>
        <button type="submit" class="btn btn-primary">Save Travel Info</button>
    </form>
</div>