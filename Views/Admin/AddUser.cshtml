@model KarnelTravelGuide.Models.User
@{
    ViewData["Title"] = "Add User";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="page-head">
    <div><h1>Add User</h1><p>Create a new user account.</p></div>
    <a href="/Admin/Users" class="btn btn-light">← Back</a>
</div>

<div class="card" style="padding:25px;">
    <form asp-action="AddUser" method="post">
        @Html.AntiForgeryToken()
        <div class="form-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:15px;">
            <div class="form-group"><label>Full Name</label><input asp-for="Name" class="form-control" placeholder="Enter full name" required /></div>
            <div class="form-group"><label>Email</label><input asp-for="Email" class="form-control" type="email" placeholder="Enter email" required /></div>
            <div class="form-group"><label>Phone</label><input asp-for="Phone" class="form-control" placeholder="Enter phone" /></div>
            <div class="form-group">
                <label>Role</label>
                <select asp-for="Role" class="form-control"><option>User</option><option>Admin</option></select>
            </div>
            <div class="form-group">
                <label>Status</label>
                <select asp-for="Status" class="form-control"><option>Active</option><option>Blocked</option></select>
            </div>
        </div>
        <br />
        <div class="actions"><button type="submit" class="btn btn-primary">Save</button><a href="/Admin/Users" class="btn btn-light">Cancel</a></div>
    </form>
</div>