<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KarnelTravelGuide.com</title>

    <link rel="icon" type="image/jpeg" href="~/favicon.jpg" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg fixed-top navbar-custom" id="mainNav">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <i class="fas fa-plane-departure me-2"></i>KarnelTravelGuide
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="About">About</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Search">Search</a></li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" asp-controller="Home" asp-action="Information" id="infoDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Information
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="infoDropdown">
                            <li><a class="dropdown-item fw-bold" style="color:#0a5c5c;" asp-controller="Home" asp-action="Information">All Information</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" asp-controller="Home" asp-action="TouristSpots">Tourist Spots</a></li>
                            <li><a class="dropdown-item" asp-controller="Home" asp-action="Hotels">Hotels</a></li>
                            <li><a class="dropdown-item" asp-controller="Home" asp-action="Restaurants">Restaurants</a></li>
                            <li><a class="dropdown-item" asp-controller="Home" asp-action="Resorts">Resorts</a></li>
                            <li><a class="dropdown-item" asp-controller="Home" asp-action="TravelInfo">Travel Info</a></li>
                        </ul>
                    </li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contact">Contact Us</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <main role="main" class="main-content">
        @RenderBody()
    </main>

    <footer class="footer-section">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6" data-aos="fade-up">
                    <h4 class="footer-brand"><i class="fas fa-plane-departure me-2"></i>KarnelTravelGuide.com</h4>
                    <p>Your trusted travel companion for exploring the breathtaking landscapes, rich culture, and historical heritage of Pakistan.</p>
                    <div class="social-icons mt-3">
                        <a href="#" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
                        <a href="#" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                        <a href="#" aria-label="YouTube"><i class="fab fa-youtube"></i></a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-6" data-aos="fade-up" data-aos-delay="100">
                    <h5 class="footer-title">Quick Links</h5>
                    <ul class="footer-links">
                        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li><a asp-controller="Home" asp-action="TouristSpots">Tourist Spots</a></li>
                        <li><a asp-controller="Home" asp-action="Hotels">Hotels</a></li>
                        <li><a asp-controller="Home" asp-action="Restaurants">Restaurants</a></li>
                        <li><a asp-controller="Home" asp-action="Resorts">Resorts</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-md-6" data-aos="fade-up" data-aos-delay="200">
                    <h5 class="footer-title">Explore</h5>
                    <ul class="footer-links">
                        <li><a asp-controller="Home" asp-action="TravelInfo">Travel Info</a></li>
                        <li><a asp-controller="Home" asp-action="About">About Us</a></li>
                        <li><a asp-controller="Home" asp-action="Contact">Contact</a></li>
                        <li><a asp-controller="Home" asp-action="Search">Search</a></li>
                    </ul>
                </div>
                <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="300">
                    <h5 class="footer-title">Contact Us</h5>
                    <ul class="footer-contact">
                        <li><i class="fas fa-map-marker-alt me-2"></i>Main Boulevard, Gulberg III, Lahore, Pakistan</li>
                        <li><i class="fas fa-phone me-2"></i>+92 300 1234567</li>
                        <li><i class="fas fa-envelope me-2"></i>info@karneltravelguide.com</li>
                    </ul>
                </div>
            </div>
            <hr class="footer-divider" />
            <div class="text-center footer-bottom">
                <p>&copy; @DateTime.Now.Year KarnelTravelGuide.com - All Rights Reserved</p>
            </div>
        </div>
    </footer>

    <button id="backToTop" aria-label="Back to top"><i class="fas fa-arrow-up"></i></button>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>