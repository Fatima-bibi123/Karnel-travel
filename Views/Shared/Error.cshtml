
@{
    ViewData["Title"] = "Error";
}

<div class="container text-center error-page">
    <h1 class="error-code">404</h1>
    <h2 class="error-message">Oops! Page Not Found</h2>
    <p class="error-description">The page you are looking for might have been removed or is temporarily unavailable.</p>
    <a href="@Url.Action("Index", "Home")" class="btn btn-view-all">Go Back Home</a>
</div>
