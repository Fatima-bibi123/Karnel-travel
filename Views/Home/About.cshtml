@{
    ViewData["Title"] = "About Us";
}

<style>
    .text-primary {
        color: #0a5c5c !important;
    }

    .btn-primary {
        background-color: #0a5c5c !important;
        border-color: #0a5c5c !important;
    }

        .btn-primary:hover {
            background-color: #084a4a !important;
            border-color: #084a4a !important;
        }

    .bg-primary {
        background-color: #0a5c5c !important;
    }
</style>

<!-- Page Header -->
<section class="page-header text-center text-white py-5"
         style="background: linear-gradient(rgba(0,0,0,.65), rgba(0,0,0,.65)), url('https://images.pexels.com/photos/1271619/pexels-photo-1271619.jpeg?auto=compress&cs=tinysrgb&w=1600') center/cover;">
    <div class="container py-5">
        <h1 class="display-4 fw-bold" data-aos="fade-down">About Us</h1>
        <p class="lead" data-aos="fade-up">
            Discover Pakistan with KarnelTravelGuide.com
        </p>
    </div>
</section>

<!-- Who We Are -->
<section class="py-5">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-6" data-aos="fade-right">
                <img src="https://images.pexels.com/photos/15916728/pexels-photo-15916728.jpeg?auto=compress&cs=tinysrgb&h=650&w=940"
                     class="img-fluid rounded shadow"
                     alt="Beautiful travel destination"
                     style="width:100%; height:380px; object-fit:cover;" />
            </div>

            <div class="col-lg-6" data-aos="fade-left">
                <h6 class="text-primary fw-bold text-uppercase">Who We Are</h6>
                <h2 class="fw-bold mb-3">Welcome to KarnelTravelGuide.com</h2>

                <p class="text-muted">
                    KarnelTravelGuide.com is a travel guide platform designed
                    to help tourists explore beautiful destinations across
                    Pakistan. Our aim is to make travel planning easier by
                    providing useful information about tourist spots, hotels,
                    restaurants, resorts and travel facilities.
                </p>

                <p class="text-muted">
                    Whether you are planning a family holiday, a trip with
                    friends or a relaxing visit to the mountains, our platform
                    helps you discover destinations and plan your journey
                    according to your interests.
                </p>

                <div class="row text-center mt-4 g-3">
                    <div class="col-4">
                        <h3 class="text-primary fw-bold">5+</h3>
                        <p class="small mb-0">Cities</p>
                    </div>
                    <div class="col-4">
                        <h3 class="text-primary fw-bold">250+</h3>
                        <p class="small mb-0">Destinations</p>
                    </div>
                    <div class="col-4">
                        <h3 class="text-primary fw-bold">24/7</h3>
                        <p class="small mb-0">Travel Information</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Our Journey -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-6 order-lg-2" data-aos="fade-left">
                <img src="https://images.pexels.com/photos/1005417/pexels-photo-1005417.jpeg?auto=compress&cs=tinysrgb&h=650&w=940"
                     class="img-fluid rounded shadow"
                     alt="Tourists exploring a destination"
                     style="width:100%; height:380px; object-fit:cover;" />
            </div>

            <div class="col-lg-6 order-lg-1" data-aos="fade-right">
                <h6 class="text-primary fw-bold text-uppercase">Our Journey</h6>
                <h2 class="fw-bold mb-3">Making Travel Planning Easier</h2>

                <p class="text-muted">
                    Traveling to a new place can be exciting, but finding
                    suitable accommodation, restaurants and transportation
                    information can sometimes be difficult.
                </p>

                <p class="text-muted">
                    KarnelTravelGuide.com brings helpful travel information
                    together in one place. Visitors can explore destinations,
                    compare available options and learn more about facilities
                    before planning their trip.
                </p>

                <ul class="list-unstyled mt-3">
                    <li class="mb-2">
                        <span class="text-primary fw-bold me-2">&#10003;</span>
                        Information about tourist destinations
                    </li>
                    <li class="mb-2">
                        <span class="text-primary fw-bold me-2">&#10003;</span>
                        Hotel, resort and restaurant guides
                    </li>
                    <li class="mb-2">
                        <span class="text-primary fw-bold me-2">&#10003;</span>
                        Travel planning information
                    </li>
                    <li class="mb-2">
                        <span class="text-primary fw-bold me-2">&#10003;</span>
                        Useful information for tourists
                    </li>
                </ul>
            </div>
        </div>
    </div>
</section>

<!-- Facilities -->
<section class="py-5">
    <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
            <h6 class="text-primary fw-bold text-uppercase">Our Facilities</h6>
            <h2 class="fw-bold">What We Provide</h2>
            <p class="text-muted">
                Helpful travel information to support your journey.
            </p>
        </div>

        <div class="row g-4">

            <!-- Transportation -->
            <div class="col-md-6 col-lg-4" data-aos="fade-up">
                <div class="card h-100 border-0 shadow-sm text-center p-4">
                    <div class="mb-3">
                        <i class="fas fa-bus fa-3x text-primary"></i>
                    </div>
                    <h4 class="fw-bold">Transportation</h4>
                    <p class="text-muted mb-0">
                        Explore transportation information for reaching
                        tourist destinations, including available travel
                        options and journey planning guidance.
                    </p>
                </div>
            </div>

            <!-- Travel Packages -->
            <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="100">
                <div class="card h-100 border-0 shadow-sm text-center p-4">
                    <div class="mb-3">
                        <i class="fas fa-suitcase-rolling fa-3x text-primary"></i>
                    </div>
                    <h4 class="fw-bold">Travel Packages</h4>
                    <p class="text-muted mb-0">
                        Discover travel package information and plan
                        trips according to your destination, interests,
                        schedule and budget.
                    </p>
                </div>
            </div>

            <!-- Accommodation -->
            <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="200">
                <div class="card h-100 border-0 shadow-sm text-center p-4">
                    <div class="mb-3">
                        <i class="fas fa-hotel fa-3x text-primary"></i>
                    </div>
                    <h4 class="fw-bold">Accommodation</h4>
                    <p class="text-muted mb-0">
                        Find information about hotels, resorts and
                        accommodation options near tourist destinations
                        to help plan a comfortable stay.
                    </p>
                </div>
            </div>

            <!-- Tourist Destinations -->
            <div class="col-md-6 col-lg-4" data-aos="fade-up">
                <div class="card h-100 border-0 shadow-sm text-center p-4">
                    <div class="mb-3">
                        <i class="fas fa-mountain fa-3x text-primary"></i>
                    </div>
                    <h4 class="fw-bold">Tourist Destinations</h4>
                    <p class="text-muted mb-0">
                        Explore mountains, valleys, lakes, historical
                        places and other beautiful tourist attractions
                        across Pakistan.
                    </p>
                </div>
            </div>

            <!-- Restaurants -->
            <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="100">
                <div class="card h-100 border-0 shadow-sm text-center p-4">
                    <div class="mb-3">
                        <i class="fas fa-utensils fa-3x text-primary"></i>
                    </div>
                    <h4 class="fw-bold">Restaurants & Food</h4>
                    <p class="text-muted mb-0">
                        Find restaurant information and explore dining
                        options to make your travel experience more enjoyable.
                    </p>
                </div>
            </div>

            <!-- Travel Information -->
            <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="200">
                <div class="card h-100 border-0 shadow-sm text-center p-4">
                    <div class="mb-3">
                        <i class="fas fa-map-marked-alt fa-3x text-primary"></i>
                    </div>
                    <h4 class="fw-bold">Travel Information</h4>
                    <p class="text-muted mb-0">
                        Access useful destination details and travel
                        guidance to prepare for your trip with greater
                        confidence.
                    </p>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- Mission and Vision -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
            <h6 class="text-primary fw-bold text-uppercase">Our Purpose</h6>
            <h2 class="fw-bold">Our Mission & Vision</h2>
        </div>

        <div class="row g-4">
            <div class="col-md-6" data-aos="fade-right">
                <div class="bg-white rounded shadow-sm p-4 h-100">
                    <div class="mb-3">
                        <i class="fas fa-bullseye fa-2x text-primary"></i>
                    </div>
                    <h4 class="fw-bold">Our Mission</h4>
                    <p class="text-muted mb-0">
                        Our mission is to make travel planning simpler
                        by providing organized information about tourist
                        locations, transportation options, travel packages,
                        hotels, resorts and restaurants.
                    </p>
                </div>
            </div>

            <div class="col-md-6" data-aos="fade-left">
                <div class="bg-white rounded shadow-sm p-4 h-100">
                    <div class="mb-3">
                        <i class="fas fa-eye fa-2x text-primary"></i>
                    </div>
                    <h4 class="fw-bold">Our Vision</h4>
                    <p class="text-muted mb-0">
                        Our vision is to become a useful travel guide
                        platform for people who want to discover Pakistan,
                        explore new destinations and make informed travel
                        decisions.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Why Choose Us -->
<section class="py-5">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-6" data-aos="fade-right">
                <h6 class="text-primary fw-bold text-uppercase">Why Choose Us</h6>
                <h2 class="fw-bold mb-4">Plan Your Journey with Confidence</h2>

                <div class="d-flex mb-4">
                    <div class="me-3 text-primary">
                        <i class="fas fa-search fa-2x"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold">Easy Destination Search</h5>
                        <p class="text-muted mb-0">
                            Explore available destinations and find
                            information relevant to your travel plans.
                        </p>
                    </div>
                </div>

                <div class="d-flex mb-4">
                    <div class="me-3 text-primary">
                        <i class="fas fa-hotel fa-2x"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold">Travel Facilities in One Place</h5>
                        <p class="text-muted mb-0">
                            Browse information about accommodation,
                            restaurants, resorts and tourist attractions.
                        </p>
                    </div>
                </div>

                <div class="d-flex mb-4">
                    <div class="me-3 text-primary">
                        <i class="fas fa-route fa-2x"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold">Better Travel Planning</h5>
                        <p class="text-muted mb-0">
                            Prepare for your journey by reviewing
                            destination and travel information before
                            you leave.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-lg-6" data-aos="fade-left">
                <img src="https://images.pexels.com/photos/210182/pexels-photo-210182.jpeg?auto=compress&cs=tinysrgb&h=650&w=940"
                     class="img-fluid rounded shadow"
                     alt="Travel destination scenery"
                     style="width:100%; height:400px; object-fit:cover;" />
            </div>
        </div>
    </div>
</section>

<!-- Call to Action -->
<section class="py-5 text-white text-center"
         style="background: linear-gradient(rgba(0,0,0,.7), rgba(0,0,0,.7)), url('https://images.pexels.com/photos/338504/pexels-photo-338504.jpeg?auto=compress&cs=tinysrgb&w=1600') center/cover;">
    <div class="container py-4" data-aos="zoom-in">
        <h2 class="fw-bold mb-3">Start Exploring Pakistan</h2>
        <p class="lead mb-4">
            Discover destinations, explore travel facilities and plan
            your next adventure with KarnelTravelGuide.com.
        </p>
        <a asp-controller="Home"
           asp-action="Search"
           class="btn btn-primary btn-lg px-4">
            Explore Destinations
        </a>
    </div>
</section>