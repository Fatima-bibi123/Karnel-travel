@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Information";
    var newHotels = ViewBag.NewHotels as List<KarnelTravelGuide.Models.Hotel> ?? new List<KarnelTravelGuide.Models.Hotel>();
    var newRestaurants = ViewBag.NewRestaurants as List<KarnelTravelGuide.Models.Restaurant> ?? new List<KarnelTravelGuide.Models.Restaurant>();
    var newResorts = ViewBag.NewResorts as List<KarnelTravelGuide.Models.Resort> ?? new List<KarnelTravelGuide.Models.Resort>();
    var packages = ViewBag.Packages as List<dynamic> ?? new List<dynamic>();
    var cities = new List<string> { "Murree", "Hunza Valley", "Islamabad", "Karachi", "Lahore" };
}

<style>
    .info-hero {
        background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('https://images.unsplash.com/photo-1506905925346-21bda4d32df4?q=80&w=2070');
        background-size: cover;
        background-position: center 40%;
        height: 320px;
        margin-top: -76px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        color: white;
        text-align: center;
    }

        .info-hero h1 {
            font-size: 48px;
            font-weight: 800;
        }

    header nav.navbar {
        background: transparent !important;
        background-color: transparent !important;
        position: absolute !important;
        top: 0;
        left: 0;
        right: 0;
        box-shadow: none !important;
        z-index: 1000;
    }

        header nav.navbar .nav-link {
            color: white !important;
        }

            header nav.navbar .nav-link.active {
                border-bottom: 2px solid #f0b429;
            }

    .info-card {
        border: none;
        border-radius: 15px;
        background: white;
        box-shadow: 0 4px 15px rgba(0,0,0,0.07);
        transition: 0.3s;
    }

        .info-card:hover {
            transform: translateY(-5px);
        }

    .info-icon {
        width: 55px;
        height: 55px;
        background: #e6f2f2;
        color: #0a5c5c;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        margin: 0 auto 12px;
    }

    .hotel-img {
        height: 180px;
        object-fit: cover;
        border-top-left-radius: 15px;
        border-top-right-radius: 15px;
        width: 100%;
    }

    .search-wrapper {
        position: relative;
        z-index: 10;
    }

    .custom-suggest {
        position: absolute;
        top: 100%;
        left: 0;
        right: 80px;
        background: white;
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.15);
        margin-top: 8px;
        z-index: 11;
        display: none;
        overflow: hidden;
    }

        .custom-suggest div {
            padding: 10px 18px;
            cursor: pointer;
        }

            .custom-suggest div:hover {
                background: #e6f2f2;
                color: #0a5c5c;
            }
</style>

<div class="info-hero">
    <h1>Information</h1>
    <p>Discover Pakistan with KarnelTravelGuide.com</p>
</div>

<div class="container py-5">
    <div class="row justify-content-center mb-5 search-wrapper">
        <div class="col-md-7 search-wrapper">
            <form asp-action="Search" method="get" class="d-flex shadow-sm p-2 bg-white rounded-pill">
                <div class="flex-grow-1 position-relative">
                    <input type="text" id="locationInput" name="location" class="form-control border-0 rounded-pill ps-4" placeholder="Search by location, city, beach..." autocomplete="off" />
                    <div id="suggestBox" class="custom-suggest">
                        @foreach (var c in cities)
                        {
                            <div onclick="selectCity('@c')">@c</div>
                        }
                    </div>
                </div>
                <button type="submit" class="btn rounded-pill px-4 ms-2" style="background:#0a5c5c; color:white;">Search</button>
                <a asp-action="AdvancedSearch" class="btn btn-outline-secondary rounded-pill px-3 ms-2">Advanced</a>
            </form>
        </div>
    </div>

    <h4 class="mb-4" style="color:#0a5c5c; font-weight:700;">Explore Information</h4>
    <div class="row g-4 mb-5">
        <div class="col-6 col-md-4 col-lg"><a asp-action="TouristSpots" class="text-decoration-none"><div class="card info-card text-center p-3 h-100"><div class="info-icon"><i class="fas fa-mountain"></i></div><h6 style="color:#0a5c5c; font-weight:700;">Tourist Spots</h6><small class="text-muted">Beaches, Monuments</small></div></a></div>
        <div class="col-6 col-md-4 col-lg"><a asp-action="TravelInfo" class="text-decoration-none"><div class="card info-card text-center p-3 h-100"><div class="info-icon"><i class="fas fa-bus"></i></div><h6 style="color:#0a5c5c; font-weight:700;">Travel Info</h6><small class="text-muted">Bus, Train, Flight</small></div></a></div>
        <div class="col-6 col-md-4 col-lg"><a asp-action="Hotels" class="text-decoration-none"><div class="card info-card text-center p-3 h-100"><div class="info-icon"><i class="fas fa-hotel"></i></div><h6 style="color:#0a5c5c; font-weight:700;">Hotels</h6><small class="text-muted">PKR 7000+</small></div></a></div>
        <div class="col-6 col-md-4 col-lg"><a asp-action="Restaurants" class="text-decoration-none"><div class="card info-card text-center p-3 h-100"><div class="info-icon"><i class="fas fa-utensils"></i></div><h6 style="color:#0a5c5c; font-weight:700;">Restaurants</h6><small class="text-muted">Pakistani, BBQ</small></div></a></div>
        <div class="col-6 col-md-4 col-lg"><a asp-action="Resorts" class="text-decoration-none"><div class="card info-card text-center p-3 h-100"><div class="info-icon"><i class="fas fa-umbrella-beach"></i></div><h6 style="color:#0a5c5c; font-weight:700;">Resorts</h6><small class="text-muted">Beach Resorts</small></div></a></div>
    </div>

    <h4 class="mb-3" style="color:#0a5c5c; font-weight:700;">New Hotels</h4>
    <div class="row g-4 mb-5">
        @foreach (var h in newHotels)
        {
            <div class="col-md-3 col-sm-6"><div class="card info-card h-100"><img src="@(string.IsNullOrEmpty(h.ImageUrl) ? "/images/no-image.jpg" : h.ImageUrl)" class="hotel-img" /><div class="card-body"><h6 style="font-size:14px; color:#0a5c5c;">@h.Name</h6><small class="text-muted">@h.City | @h.Rating ★</small><p class="mt-2 mb-0 fw-bold" style="color:#0a5c5c;">PKR @h.PricePerNight.ToString("N0")</p></div></div></div>
        }
    </div>

    <h4 class="mb-3" style="color:#0a5c5c; font-weight:700;">New Restaurants</h4>
    <div class="row g-4 mb-5">
        @foreach (var r in newRestaurants)
        {
            <div class="col-md-3 col-sm-6"><div class="card info-card h-100"><img src="@(string.IsNullOrEmpty(r.ImageUrl) ? "/images/no-image.jpg" : r.ImageUrl)" class="hotel-img" /><div class="card-body"><h6 style="font-size:14px; color:#0a5c5c;">@r.Name</h6><small class="text-muted">@r.City | @r.Rating ★</small><p class="mt-2 mb-0 fw-bold" style="color:#0a5c5c;">PKR @r.Price.ToString("N0")</p></div></div></div>
        }
    </div>

    <h4 class="mb-3" style="color:#0a5c5c; font-weight:700;">New Resorts</h4>
    <div class="row g-4 mb-5">
        @foreach (var rs in newResorts)
        {
            <div class="col-md-3 col-sm-6"><div class="card info-card h-100"><img src="@(string.IsNullOrEmpty(rs.ImageUrl) ? "/images/no-image.jpg" : rs.ImageUrl)" class="hotel-img" /><div class="card-body"><h6 style="font-size:14px; color:#0a5c5c;">@rs.Name</h6><small class="text-muted">@rs.City | @rs.Rating ★</small><p class="mt-2 mb-0 fw-bold" style="color:#0a5c5c;">PKR @rs.Price.ToString("N0")</p></div></div></div>
        }
    </div>

    <h4 class="mb-3" style="color:#0a5c5c; font-weight:700;">Packages & Discounts</h4>
    <div class="row g-4">
        @foreach (var p in packages)
        {
            <div class="col-md-4"><div class="card info-card p-3 h-100" style="border-left:5px solid #0a5c5c;"><div class="d-flex justify-content-between"><h6 class="fw-bold mb-0" style="font-size:14px;">@p.Name</h6><span class="badge bg-success" style="font-size:11px;">@p.Discount</span></div><small class="text-muted mt-1 d-block">@p.Days - @p.City</small><p class="fw-bold mt-2 mb-0" style="color:#0a5c5c;">PKR @p.Price</p></div></div>
        }
    </div>
</div>

<script>
    const input = document.getElementById('locationInput');
    const box = document.getElementById('suggestBox');
    input.addEventListener('focus', () => box.style.display = 'block');
    input.addEventListener('input', () => { const val = input.value.toLowerCase(); box.style.display = 'block'; [...box.children].forEach(d => d.style.display = d.textContent.toLowerCase().includes(val) ? 'block' : 'none'); });
    document.addEventListener('click', (e) => { if(!e.target.closest('.search-wrapper')) box.style.display = 'none'; });
    function selectCity(c){ input.value = c; box.style.display = 'none'; }
</script>