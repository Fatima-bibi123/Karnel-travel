@{
    ViewData["Title"] = "Search";
    var hasSearched = ViewBag.HasSearched != null && (bool)ViewBag.HasSearched;
    var touristSpots = ViewBag.TouristSpots as List<TouristSpot>;
    var hotels = ViewBag.Hotels as List<Hotel>;
    var restaurants = ViewBag.Restaurants as List<Restaurant>;
    var resorts = ViewBag.Resorts as List<Resort>;
}
<style>
    .page-header {
        background-image: linear-gradient(rgba(0,0,0,0.65), rgba(0,0,0,0.65)), url('https://images.pexels.com/photos/3935702/pexels-photo-3935702.jpeg?auto=compress&cs=tinysrgb&w=1260');
        background-size: cover;
        background-position: center;
        padding: 120px 0 100px;
    }

        .page-header h1 {
            color: white;
            font-size: 58px;
            font-weight: 800;
            font-family: Georgia, serif;
        }

        .page-header p {
            color: #e0e0e0;
            font-size: 18px;
            margin-top: 10px;
        }

    .search-page-section {
        background: #f5f7f8;
        padding: 80px 0 60px;
        min-height: 80vh;
    }

    .search-card {
        background: #fff;
        border-radius: 24px;
        padding: 50px 40px;
        box-shadow: 0 15px 50px rgba(0,0,0,0.08);
        text-align: center;
        max-width: 900px;
        margin: -130px auto 0;
        position: relative;
        z-index: 2;
    }

        .search-card h2 {
            color: #0a5c5c;
            font-family: Georgia, serif;
            font-weight: 700;
            font-size: 32px;
        }

    .search-input-group {
        border-radius: 50px;
        overflow: hidden;
        border: 1.5px solid #e6ecec;
        display: flex;
        margin-top: 30px;
        background: white;
    }

        .search-input-group .search-icon {
            background: #0a5c5c;
            color: white;
            width: 70px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }

    .search-input {
        border: none !important;
        height: 62px;
        flex: 1;
        padding-left: 20px;
        font-size: 16px;
        outline: none;
    }

    .btn-search {
        background: #0a5c5c;
        color: white;
        border: none;
        height: 62px;
        padding: 0 40px;
        font-weight: 700;
        font-size: 16px;
    }

        .btn-search:hover {
            background: #084a4a;
            color: white;
        }

    .advanced-link {
        display: inline-block;
        margin-top: 22px;
        color: #0a5c5c;
        font-weight: 700;
        text-decoration: none;
        border: 1.8px solid #0a5c5c;
        padding: 10px 28px;
        border-radius: 50px;
        transition: 0.3s;
    }

        .advanced-link:hover {
            background: #0a5c5c;
            color: white;
        }

    .result-card {
        background: #fff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 25px rgba(0,0,0,0.07);
        transition: 0.3s;
        height: 100%;
        border: 1px solid #eef2f2;
    }

        .result-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.12);
        }

        .result-card img {
            height: 210px;
            object-fit: cover;
            width: 100%;
        }
</style>

<section class="page-header text-center">
    <div class="container"><h1>Search</h1><p>Find tourist spots, hotels, restaurants by city</p></div>
</section>

<section class="search-page-section">
    <div class="container">
        <div class="search-card">
            <h2>Where do you want to go?</h2>
            <p class="text-muted">Simple Search - Only by Location</p>
            <form asp-action="Search" method="get">
                <div class="input-group search-input-group mx-auto">
                    <span class="input-group-text search-icon"><i class="fas fa-map-marker-alt"></i></span>
                    <select name="location" class="form-control search-input">
                        <option value="">Select your destination...</option>
                        <option value="Karachi">Karachi - City of Lights</option>
                        <option value="Lahore">Lahore - Heart of Punjab</option>
                        <option value="Islamabad">Islamabad - Capital City</option>
                        <option value="Hunza Valley">Hunza Valley - Heaven on Earth</option>
                        <option value="Murree">Murree - Hill Station</option>
                    </select>
                    <button type="submit" class="btn btn-search">Search</button>
                </div>
            </form>
            <a href="@Url.Action("AdvancedSearch", "Home")" class="advanced-link">
                <i class="fas fa-sliders-h"></i> Go to Advanced Search (Price, Quality, Quantity, Availability)
            </a>
            <div class="mt-3 small text-muted">Hotels from PKR @ViewBag.MinHotelPrice to @ViewBag.MaxHotelPrice</div>
        </div>

        @if (hasSearched)
        {
            <div class="mt-5">
                <h2 style="font-family:Georgia, serif; font-weight:700;">Results for "@ViewBag.SearchQuery"</h2>
                <div class="row g-4 mt-3">
                    @if (touristSpots != null)
                    {
                        @foreach (var s in touristSpots)
                        {
                            <div class="col-md-4"><div class="result-card"><img src="@s.ImageUrl" /><div class="p-3 text-start"><h6 style="font-weight:700;">@s.Name</h6><p class="small text-muted mb-2"><i class="fas fa-map-marker-alt text-danger"></i> @s.Location - @s.Category</p><span class="badge" style="background:#0a5c5c; padding:6px 12px; border-radius:20px;">PKR @s.Price</span> <span class="small ms-2">⭐ @s.Rating</span></div></div></div>
                        }
                    }
                    @if (hotels != null)
                    {
                        @foreach (var h in hotels)
                        {
                            <div class="col-md-3"><div class="result-card"><img src="@h.ImageUrl" style="height:180px;" /><div class="p-3 text-start"><h6 style="font-weight:700;">@h.Name</h6><p class="small text-muted mb-2">@h.City</p><span class="badge" style="background:#0a5c5c; padding:6px 12px; border-radius:20px;">PKR @h.PricePerNight / night</span> <span class="small ms-2">⭐ @h.Rating</span></div></div></div>
                        }
                    }
                    @if (restaurants != null)
                    {
                        @foreach (var r in restaurants)
                        {
                            <div class="col-md-3"><div class="result-card"><img src="@r.ImageUrl" style="height:180px;" /><div class="p-3 text-start"><h6 style="font-weight:700;">@r.Name</h6><p class="small text-muted mb-2">@r.City - @r.Cuisine</p><span class="badge" style="background:#0a5c5c; padding:6px 12px; border-radius:20px;">PKR @r.Price</span> <span class="small ms-2">⭐ @r.Rating</span></div></div></div>
                        }
                    }
                    @if (resorts != null)
                    {
                        @foreach (var res in resorts)
                        {
                            <div class="col-md-3"><div class="result-card"><img src="@res.ImageUrl" style="height:180px;" /><div class="p-3 text-start"><h6 style="font-weight:700;">@res.Name</h6><p class="small text-muted mb-2">@res.City</p><span class="badge" style="background:#0a5c5c; padding:6px 12px; border-radius:20px;">PKR @res.Price</span> <span class="small ms-2">⭐ @res.Rating</span></div></div></div>
                        }
                    }
                </div>
            </div>
        }
    </div>
</section>